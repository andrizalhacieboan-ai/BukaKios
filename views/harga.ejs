<%- include('header') %>
<%- include('sidebar', { user: user, page: 'harga' }) %>

<main class="flex-1 p-8 overflow-auto">
    <h2 class="text-2xl font-bold text-green-400 mb-6">Daftar Harga Produk</h2>
    
    <div class="mb-4 flex items-center space-x-4">
        <input type="text" id="searchInput" placeholder="Cari produk atau kode" class="w-full max-w-md bg-black/40 border border-gray-600 rounded px-4 py-2 text-green-300 focus:border-green-400 focus:outline-none">
    </div>

    <div class="bg-gray-800/50 border border-green-500/30 rounded-lg p-6 card-glow overflow-x-auto">
        <% if (typeof error !== 'undefined' && error) { %>
            <p class="text-red-400"><%= error %></p>
        <% } else { %>
        <table class="w-full text-left text-sm table-dark" id="priceTable">
            <thead>
                <tr>
                    <th class="py-3 px-4">Kategori</th>
                    <th class="py-3 px-4">Kode Produk</th>
                    <th class="py-3 px-4">Nama Produk</th>
                    <th class="py-3 px-4 text-right">Harga</th>
                    <th class="py-3 px-4 text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(function(prod) { %>
                <tr class="searchable-item">
                    <td class="py-3 px-4 text-blue-300 text-xs"><%= prod.kategori || '-' %></td>
                    <td class="py-3 px-4 text-green-300 font-mono font-bold"><%= prod.kode %></td>
                    <td class="py-3 px-4 text-white"><%= prod.keterangan %></td>
                    <td class="py-3 px-4 text-white text-right font-bold">Rp <%= Number(prod.harga).toLocaleString('id-ID') %></td>
                    <td class="py-3 px-4 text-center">
                        <% if(prod.status === 'normal') { %>
                            <span class="bg-green-500/20 text-green-400 px-2 py-1 rounded text-xs font-bold">Normal</span>
                        <% } else { %>
                            <span class="bg-red-500/20 text-red-400 px-2 py-1 rounded text-xs font-bold"><%= prod.status %></span>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% } %>
    </div>
</main>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function(e) {
        var term = e.target.value.toLowerCase();
        var items = document.querySelectorAll('.searchable-item');
        items.forEach(function(item) {
            var text = item.textContent.toLowerCase();
            item.style.display = text.includes(term) ? '' : 'none';
        });
    });
</script>
</body>
</html>