<%- include('/header') %>
<%- include('/sidebar', { user: user, page: 'deposit' }) %>

<main class="flex-1 p-8 overflow-auto">
    <h2 class="text-2xl font-bold text-green-400 mb-6">Deposit Saldo</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-gray-800/50 border border-green-500/30 rounded-lg p-6 card-glow">
            <h3 class="text-xl font-bold text-blue-300 mb-4">Request Top Up</h3>
            <p class="text-gray-400 text-sm mb-6">Saldo Anda saat ini: <span class="text-green-400 font-bold text-lg">Rp <%= user.balance.toLocaleString() %></span></p>
            
            <form action="/deposit" method="POST" class="space-y-4">
                <div>
                    <label class="block text-green-300 text-sm mb-2">Nominal Deposit</label>
                    <input type="number" name="amount" min="10000" step="1000" required placeholder="Minimal Rp 10.000" class="w-full bg-black/40 border border-gray-600 rounded px-4 py-2 text-green-300 focus:border-green-400 focus:outline-none">
                </div>
                <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded transition btn-glow">
                    Kirim Request Deposit
                </button>
            </form>

            <div class="mt-6 p-4 bg-blue-900/20 border border-blue-500/30 rounded text-blue-300 text-xs">
                <p>* Request deposit akan ditinjau oleh Admin. Pastikan sudah melakukan transfer ke rekening Admin Andri Store.</p>
            </div>
        </div>

        <% if (user.role === 'admin') { %>
        <div class="bg-gray-800/50 border border-blue-500/30 rounded-lg p-6 card-glow">
            <h3 class="text-xl font-bold text-blue-300 mb-4">Deposit Server (Okeconnect)</h3>
            <p class="text-gray-400 text-sm mb-6">Sebagai admin, Anda dapat langsung mengisi saldo server Okeconnect melalui website resmi.</p>
            <a href="https://okeconnect.com/deposit/add" target="_blank" class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded transition text-center">
                Buka Halaman Deposit Okeconnect
            </a>
        </div>
        <% } %>
    </div>

    <div class="bg-gray-800/50 border border-blue-500/30 rounded-lg p-6 card-glow overflow-x-auto">
        <h3 class="text-xl font-bold text-green-300 mb-4">Riwayat Deposit Anda</h3>
        <table class="w-full text-left text-sm table-dark">
            <thead>
                <tr>
                    <th class="py-3 px-4">ID</th>
                    <th class="py-3 px-4">Jumlah</th>
                    <th class="py-3 px-4">Status</th>
                    <th class="py-3 px-4">Tanggal</th>
                </tr>
            </thead>
            <tbody>
                <% if(deposits.length === 0) { %>
                <tr>
                    <td colspan="4" class="py-4 text-center text-gray-500">Belum ada riwayat deposit.</td>
                </tr>
                <% } else { %>
                    <% deposits.forEach(function(dep) { %>
                    <tr>
                        <td class="py-3 px-4 text-green-300 font-mono">#<%= dep.id %></td>
                        <td class="py-3 px-4 text-white font-bold">Rp <%= dep.amount.toLocaleString() %></td>
                        <td class="py-3 px-4">
                            <% if(dep.status === 'APPROVED') { %>
                                <span class="bg-green-500/20 text-green-400 px-2 py-1 rounded text-xs font-bold"><%= dep.status %></span>
                            <% } else if(dep.status === 'REJECTED') { %>
                                <span class="bg-red-500/20 text-red-400 px-2 py-1 rounded text-xs font-bold"><%= dep.status %></span>
                            <% } else { %>
                                <span class="bg-yellow-500/20 text-yellow-400 px-2 py-1 rounded text-xs font-bold animate-pulse"><%= dep.status %></span>
                            <% } %>
                        </td>
                        <td class="py-3 px-4 text-gray-400 text-xs"><%= new Date(dep.created_at).toLocaleString('id-ID') %></td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</main>
</body>
</html>
