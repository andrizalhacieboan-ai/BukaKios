<%- include('header') %>
<%- include('sidebar', { user: user, page: 'trx' }) %>

<main class="flex-1 p-8">
    <h2 class="text-2xl font-bold text-green-400 mb-6">Buat Transaksi Baru</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <form action="/buat-transaksi" method="POST" class="bg-gray-800/50 border border-blue-500/30 rounded-lg p-6 card-glow space-y-4">
            <div>
                <label class="block text-blue-300 text-sm mb-2">Produk (Contoh: T5)</label>
                <input type="text" name="product" required class="w-full rounded px-4 py-2">
            </div>
            <div>
                <label class="block text-blue-300 text-sm mb-2">Nomor Tujuan</label>
                <input type="text" name="dest" required class="w-full rounded px-4 py-2">
            </div>
            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded transition btn-glow">
                Proses Transaksi
            </button>
        </form>

        <% if (typeof result !== 'undefined' && result) { %>
        <div class="bg-gray-800/50 border border-green-500/30 rounded-lg p-6 card-glow">
            <h3 class="text-blue-300 text-sm mb-2">Respon Server:</h3>
            <div class="bg-black/40 p-4 rounded border border-green-500/50">
                <p class="text-green-300 font-mono text-sm"><%= result %></p>
            </div>
        </div>
        <% } %>
    </div>
</main>
</body>
</html>
